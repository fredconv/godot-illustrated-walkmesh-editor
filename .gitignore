# Godot 4 generated editor and import cache
.godot/

# Local editor and user-specific settings
.editor_settings-*
.vscode/
.idea/
*.sublime-workspace

# Temporary files, logs, and crash dumps
*.tmp
*.temp
*.log
*.dmp
*.stackdump
crash.*
/reports/
/logs/
/tests/e2e/_output/

# OS metadata
.DS_Store
Thumbs.db
Desktop.ini

# Local secrets and environment configuration
.env
.env.*
!.env.example
*.pem
*.key
secrets.*

# Third-party addons kept local and excluded from this repository.
# GdUnit4 is installed by CI and by developers at a pinned version (docs/DEVELOPMENT.md).
# UniBuilder is under a commercial end-user licence and must not be redistributed.
/addons/gdUnit4/
/addons/godot_mcp/
/addons/phantom-camera-main/
/addons/unibuilder/

# Local machine configuration (contains paths specific to one computer)
/.mcp.json
/.claude/

# Godot-generated import sidecars
*.import

# Local notes for the AI assistant (machine-specific paths); kept out of the repository
/MCP-CONNECTIONS-FOR-CLAUDE.md
